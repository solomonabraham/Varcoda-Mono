root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 130

[*.{md,yml,yaml,json,css,html,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{glif,plist,fea}]
indent_size = 2
trim_trailing_whitespace = false
